# ---------------------------------------------------------------------------
# Model provider. Pick ONE and set its key. Leaving everything unset is fine:
# the app falls back to a deterministic offline model and every graph feature
# (routing, tool calls, parallelism, memory) still works.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq          # groq | openai | anthropic | offline

GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional model override. Defaults per provider:
#   groq      -> openai/gpt-oss-120b
#   openai    -> gpt-4o
#   anthropic -> claude-sonnet-4-5
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------------------
# Data sources. Mocks by default.
# USE_LIVE_APIS=true switches to Open-Meteo (weather, keyless) and Wikipedia
# (images, keyless); web search additionally needs TAVILY_API_KEY.
# ---------------------------------------------------------------------------
USE_LIVE_APIS=false
MOCK_LATENCY=1.0           # seconds of simulated per-tool latency
# TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=hashing  # hashing (instant) | minilm (needs sentence-transformers)
SIMILARITY_FLOOR=0.35      # below this the graph routes to web search
# CHROMA_PATH=./data/chroma
