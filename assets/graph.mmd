config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	planner(planner)
	clarify(clarify)
	retrieve_knowledge(retrieve_knowledge)
	web_search(web_search)
	tool_planner(tool_planner)
	execute_tool(execute_tool)
	composer(composer)
	__end__([<p>__end__</p>]):::last
	__start__ --> planner;
	execute_tool --> composer;
	planner -.-> clarify;
	planner -.-> retrieve_knowledge;
	planner -.-> tool_planner;
	retrieve_knowledge -.-> tool_planner;
	retrieve_knowledge -.-> web_search;
	tool_planner -.-> composer;
	tool_planner -.-> execute_tool;
	web_search --> tool_planner;
	clarify --> __end__;
	composer --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
